# Trinacria Playground environment template
# Copy to .env.development (or .env) and adjust values.

# Runtime environment: development | staging | production
ENV=development

# Server
HOST=localhost
PORT=5000
TRUST_PROXY=false

# Database
DATABASE_URL=file:./dev.db

# OpenAPI / Swagger
OPENAPI_ENABLED=true
# Set both to enable basic auth on /docs
SWAGGER_DOCS_USERNAME=admin
SWAGGER_DOCS_PASSWORD=change-me

# CORS (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth / JWT
# Use a strong random secret in non-local environments
SECRET_KEY=replace-with-a-strong-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# Cookie domain (optional)
AUTH_COOKIE_DOMAIN=localhost

# Cron playground options
CRON_ENABLED=true
CRON_TICK_MS=1000
CRON_LOCK_TTL_MS=30000

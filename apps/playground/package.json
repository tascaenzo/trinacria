{
  "name": "playground",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "start": "node ../../packages/cli/dist/index.js start",
    "build": "node ../../packages/cli/dist/index.js build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "dev": "node ../../packages/cli/dist/index.js dev",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate dev --schema prisma/schema.prisma",
    "prisma:push": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma db push --schema prisma/schema.prisma",
    "prisma:studio": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma studio --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.4.1",
    "@prisma/client": "^7.2.0",
    "@trinacria/cli": "*",
    "@trinacria/core": "*",
    "@trinacria/cron": "*",
    "@trinacria/events": "*",
    "@trinacria/http": "*",
    "@trinacria/schema": "*",
    "argon2": "^0.44.0",
    "jose": "^6.1.3",
    "swagger-ui-dist": "^5.32.12"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "tsx": "^4.23.5"
  }
}

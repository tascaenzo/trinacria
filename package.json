{
  "name": "trinacria",
  "private": true,
  "scripts": {
    "clean": "rm -rf packages/**/dist apps/**/dist",
    "build:core": "npm run build -w @trinacria/core",
    "build:schema": "npm run build -w @trinacria/schema",
    "build:http": "npm run build -w @trinacria/http",
    "build:cron": "npm run build -w @trinacria/cron",
    "build:events": "npm run build -w @trinacria/events",
    "build:cli": "npm run build -w @trinacria/cli",
    "build:packages": "npm run build:core && npm run build:schema && npm run build:http && npm run build:cron && npm run build:events && npm run build:cli",
    "build:playground": "npm run build -w playground",
    "build:api-prisma-postgresql": "npm run build -w api-prisma-postgresql",
    "build:api-mongoose-mongodb": "npm run build -w api-mongoose-mongodb",
    "build:api-events-redis": "npm run build -w api-events-redis",
    "build:api-events-rabbitmq": "npm run build -w api-events-rabbitmq",
    "build:all": "npm run build:packages && npm run build:playground && npm run build:api-prisma-postgresql && npm run build:api-mongoose-mongodb && npm run build:api-events-redis && npm run build:api-events-rabbitmq",
    "build": "npm run build:packages",
    "rebuild": "npm run clean && npm run build",
    "dev:playground": "npm run dev -w playground",
    "dev:api-prisma-postgresql": "npm run dev -w api-prisma-postgresql",
    "dev:api-mongoose-mongodb": "npm run dev -w api-mongoose-mongodb",
    "dev:api-events-redis": "npm run dev -w api-events-redis",
    "dev:api-events-rabbitmq": "npm run dev -w api-events-rabbitmq",
    "test:packages": "npm run test -w @trinacria/core && npm run test -w @trinacria/schema && npm run test -w @trinacria/http && npm run test -w @trinacria/cron && npm run test -w @trinacria/events && npm run test -w @trinacria/cli",
    "coverage:core": "npm run test:coverage -w @trinacria/core",
    "coverage:schema": "npm run test:coverage -w @trinacria/schema",
    "coverage:all": "npm run test:coverage --workspaces --if-present",
    "docker:smoke:api-prisma-postgresql": "bash scripts/docker-smoke.sh apps/api-prisma-postgresql",
    "docker:smoke:api-mongoose-mongodb": "bash scripts/docker-smoke.sh apps/api-mongoose-mongodb",
    "docker:smoke:api-events-redis": "bash scripts/docker-smoke.sh apps/api-events-redis",
    "docker:smoke:api-events-rabbitmq": "bash scripts/docker-smoke.sh apps/api-events-rabbitmq",
    "docker:smoke:apps": "npm run docker:smoke:api-prisma-postgresql && npm run docker:smoke:api-mongoose-mongodb && npm run docker:smoke:api-events-redis && npm run docker:smoke:api-events-rabbitmq",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "precommit:check": "node scripts/pre-commit.mjs",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  }
}

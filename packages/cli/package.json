{
  "name": "@trinacria/cli",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "types": "dist/index.d.ts",
  "bin": {
    "trinacria": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs && chmod +x dist/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=90 test/**/*.test.ts"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "tsx": "^4.23.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "@trinacria/core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tascaenzo/trinacria.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
